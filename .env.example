# The udruga's name and rules are in statut.json, not here.

# Public URL of the app. Register $BETTER_AUTH_URL/api/auth/callback/certilia (and /okta) as OIDC redirect URIs.
BETTER_AUTH_URL=https://glasanje.example.hr
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Postgres password used by docker-compose (the app's DATABASE_URL is set there).
POSTGRES_PASSWORD=

# Mail (sign-in codes for guests, invitations, sealed results).
SMTP_URL=smtps://user:pass@smtp.example.hr:465
MAIL_FROM=e-Skupština <glasanje@example.hr>

# Certilia login (developer.certilia.com). Leave empty to hide the button.
CERTILIA_DISCOVERY_URL=https://idp.certilia.com/oauth2/oidcdiscovery/.well-known/openid-configuration
CERTILIA_CLIENT_ID=
CERTILIA_CLIENT_SECRET=
CERTILIA_SCOPES=openid profile email

# Okta login. Leave empty to hide the button.
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# Optional: members of this Okta group become admins (needs a "groups" claim on the authorization server).
OKTA_ADMIN_GROUP=

# Sentry (optional). Build-time: the DSN is baked into the bundles, so rebuild after changing it.
# Leave it empty to send nothing. The token and slugs upload source maps; with an organization token SENTRY_ORG
# can stay empty.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
